          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; echo \"$f\" | grep -qE '(\\.env[^/]*$|wrangler\\.jsonc?$)' && echo '{\"decision\":\"block\",\"reason\":\"Blocked: editing env/wrangler config requires manual confirmation\"}' || true; }"
          }
        ]
      }
    ]
